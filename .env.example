# NurseMate 환경변수 예시 파일
# 실제 키는 .env.local 파일을 만들어 입력하세요. (.env.local은 git에 올라가지 않습니다)

# 사용할 LLM 제공자: gemini | openai | anthropic | mock
LLM_PROVIDER=gemini

# 사용할 모델명 (예: gemini-2.5-flash, gpt-4o-mini, claude-3-5-sonnet-latest)
LLM_MODEL=gemini-2.5-flash

# 발급받은 API 키 (절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요!)
LLM_API_KEY=your_api_key_here
